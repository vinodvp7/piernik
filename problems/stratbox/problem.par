!===================================================================
! CASE 1: Isothermal Gaussian in external linear gravity
!
! EXACT SOLUTION:  rho(z) = rho0 * exp( gz * z^2 / (2 cs^2) )
! SCALE HEIGHT:    H = cs / sqrt(|gz|)
!
! With these parameters (PSM units):
!   cs^2 = gamma * kB * T / mH  ~ 56 pc^2/Myr^2
!   |gz| = 3e-4 /Myr^2
!   H    = sqrt(56 / 3e-4) ~ 432 pc
!
! Expected: Gaussian column, rho drops by e at z = H = 432 pc.
!===================================================================

 $BASE_DOMAIN
    n_d    = 4, 4, 256
    nb     = 4
    bnd_xl = 'per'
    bnd_xr = 'per'
    bnd_yl = 'per'
    bnd_yr = 'per'
    bnd_zl = 'outd'
    bnd_zr = 'outd'
    xmin   = -50.0
    xmax   =  50.0
    ymin   = -50.0
    ymax   =  50.0
    zmin   = -2000.0
    zmax   =  2000.0
 /

 $MPI_BLOCKS
    allow_uneven  = .true.
    allow_noncart = .true.
 /

 $UNITS
    units_set = "PSM"
 /

 $RESTART_CONTROL
    restart = 'none'
 /

 $END_CONTROL
    tend = 200.0
    nend = 100000
 /

 $OUTPUT_CONTROL
    problem_name = 'strat'
    run_id       = 'c01'
    dt_hdf       = 20.0
    dt_res       = 100.0
    dt_log       = 0.01
    dt_tsl       = 1.0
    vars(1:)     = 'dens', 'velz', 'ener', 'gpot'
 /

 $FLUID_IONIZED
    gamma    = 1.6667
    selfgrav = .false.
 /

 $NUMERICAL_SETUP
    cfl         = 0.3
    smalld      = 1.e-10
    smallei     = 1.e-10
    limiter     = 'vanleer'
    solver_str  = 'riemann'
 /

 $GRAVITY
    external_gp   = "linear"
    g_dir         = 0.0, 0.0, -3.0e-4
    nsub          = 20
    tune_zeq      = 1.0
    gprofs_target = "extgp"
 /

 $THERMAL
    thermal_active = .FALSE.
 /

 $RESISTIVITY
 /

 $PROBLEM_CONTROL
    test_case = 1
    d0        = 0.002
    T0        = 5000.0
    B0        = 0.0
    gz0       = -3.0e-4
 /

 $MULTIGRID_SOLVER
 /

 $MULTIGRID_GRAVITY
    grav_bnd_str = "dirichlet"
 /

 $INTERACTIONS
 /

 $AMR
 /
