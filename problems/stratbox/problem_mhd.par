!===================================================================
! CASE 3: MHD atmosphere — flux-frozen horizontal B field
!
! EXACT SOLUTION (transcendental, solved by Newton-Raphson):
!   ln(rho/rho0) + (rho - rho0)/(beta0*rho0/2) = gz*z^2/(2 cs^2)
!
!   beta0 = 8 pi rho0 cs^2 / B0^2  (midplane plasma beta)
!
! With these parameters (PSM units):
!   d0    = 0.002 Msun/pc^3
!   cs^2  ~ 72 pc^2/Myr^2
!   B0    = 0.85  (code units) -> beta0 ~ 5
!   vA^2  = B0^2/(4 pi rho0) ~ 29 pc^2/Myr^2
!   H_eff = sqrt((cs^2 + vA^2)/|gz|) ~ 580 pc  (vs 430 pc without B)
!
! The magnetic field inflates the scale height by ~34%.
! For B propto rho the profile is steeper than a pure Gaussian
! (more peaked at midplane, faster falloff in wings).
!
! NOTE: The case B = const would give an exact Gaussian with cs^2_eff.
!       The B propto rho case has no closed form but the transcendental
!       equation is exact and tested via Newton-Raphson.
!===================================================================

 $BASE_DOMAIN
    n_d    = 4, 4, 256
    nb     = 4
    bnd_xl = 'per'
    bnd_xr = 'per'
    bnd_yl = 'per'
    bnd_yr = 'per'
    bnd_zl = 'outd'
    bnd_zr = 'outd'
    xmin   = -50.0
    xmax   =  50.0
    ymin   = -50.0
    ymax   =  50.0
    zmin   = -2500.0
    zmax   =  2500.0
 /

 $MPI_BLOCKS
    allow_uneven  = .true.
    allow_noncart = .true.
 /

 $UNITS
    units_set = "PSM"
 /

 $RESTART_CONTROL
    restart = 'none'
 /

 $END_CONTROL
    tend = 200.0
    nend = 100000
 /

 $OUTPUT_CONTROL
    problem_name = 'strat'
    run_id       = 'c03'
    dt_hdf       = 20.0
    dt_res       = 100.0
    dt_log       = 0.01
    dt_tsl       = 1.0
    vars(1:)     = 'dens', 'velz', 'ener', 'gpot', 'magx'
 /

 $FLUID_IONIZED
    gamma    = 1.6667
    selfgrav = .false.
 /

 $NUMERICAL_SETUP
    cfl         = 0.3
    smalld      = 1.e-10
    smallei     = 1.e-10
    limiter     = 'vanleer'
    solver_str  = 'riemann'
 /

 $GRAVITY
    external_gp   = "linear"
    g_dir         = 0.0, 0.0, -3.0e-4
    nsub          = 20
    tune_zeq      = 1.0
    gprofs_target = "extgp"
 /

 $THERMAL
    thermal_active = .FALSE.
 /

 $RESISTIVITY
 /

 $PROBLEM_CONTROL
    test_case = 3
    d0        = 0.002
    T0        = 5000.0
    B0        = 0.85
    gz0       = -3.0e-4
 /

 $MULTIGRID_SOLVER
 /

 $MULTIGRID_GRAVITY
    grav_bnd_str = "dirichlet"
 /

 $INTERACTIONS
 /

 $AMR
 /
