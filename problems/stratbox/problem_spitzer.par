!===================================================================
! CASE 2: Spitzer (1942) self-gravitating isothermal slab
!
! EXACT SOLUTION:  rho(z) = rho0 / cosh^2(z / z0)
! SCALE HEIGHT:    z0 = cs / sqrt(2 pi G rho0)
!
! With these parameters (PSM units):
!   cs^2  ~ 72 pc^2/Myr^2  (for T=5000, gamma=5/3)
!   G     ~ 0.0045 pc^3/(Msun Myr^2)
!   rho0  = 0.1 Msun/pc^3  (~4 cm^-3)
!   z0    = sqrt(72 / (2pi*0.0045*0.1)) ~ 160 pc
!
! Column density: Sigma = 2 rho0 z0 ~ 32 Msun/pc^2
!
! IMPORTANT: external_gp = "null"  (self-gravity only, no external pot)
! IMPORTANT: boundary = 'outd' (density drops smoothly to floor)
!===================================================================

 $BASE_DOMAIN
    n_d    = 4, 4, 256
    nb     = 4
    bnd_xl = 'per'
    bnd_xr = 'per'
    bnd_yl = 'per'
    bnd_yr = 'per'
    bnd_zl = 'outd'
    bnd_zr = 'outd'
    xmin   = -50.0
    xmax   =  50.0
    ymin   = -50.0
    ymax   =  50.0
    zmin   = -800.0
    zmax   =  800.0
 /

 $MPI_BLOCKS
    allow_uneven  = .true.
    allow_noncart = .true.
 /

 $UNITS
    units_set = "PSM"
 /

 $RESTART_CONTROL
    restart = 'none'
 /

 $END_CONTROL
    tend = 200.0
    nend = 100000
 /

 $OUTPUT_CONTROL
    problem_name = 'strat'
    run_id       = 'c02'
    dt_hdf       = 20.0
    dt_res       = 100.0
    dt_log       = 0.01
    dt_tsl       = 1.0
    vars(1:)     = 'dens', 'velz', 'ener', 'gpot'
 /

 $FLUID_IONIZED
    gamma    = 1.6667
    selfgrav = .true.
 /

 $NUMERICAL_SETUP
    cfl         = 0.3
    smalld      = 1.e-10
    smallei     = 1.e-10
    limiter     = 'vanleer'
    solver_str  = 'riemann'
 /

 $GRAVITY
    external_gp   = "null"
    nsub          = 20
    tune_zeq      = 1.0
    gprofs_target = "extgp"
 /

 $THERMAL
    thermal_active = .FALSE.
 /

 $RESISTIVITY
 /

 $PROBLEM_CONTROL
    test_case = 2
    d0        = 0.1
    T0        = 5000.0
    B0        = 0.0
    gz0       = 0.0
 /

 $MULTIGRID_SOLVER
 /

 $MULTIGRID_GRAVITY
    grav_bnd_str = "dirichlet"
    norm_tol     = 1.0e-8
    max_cycles   = 50
 /

 $INTERACTIONS
 /

 $AMR
 /
