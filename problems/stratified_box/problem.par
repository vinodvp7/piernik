 !
 
 
 
 
 
 
 
 
 
 $BASE_DOMAIN
    n_d = 1, 256, 512
    nb  = 4
    bnd_xl = 'per'
    bnd_xr = 'per'
    bnd_yl = 'per'
    bnd_yr = 'per'
    bnd_zl = 'out'
    bnd_zr = 'out'
    xmin   =-500.0
    xmax   = 500.0
    ymin   =-500.0
    ymax   = 500.0
    zmin   =-1000.0       ! 2 kpc box
    zmax   = 1000.0
 /

 $MPI_BLOCKS
    psize = 2, 2, 1
 /

 $UNITS
    units_set = "PSM"
 /

 $RESTART_CONTROL
    restart  = 'last'
    res_id   = ''
 /

 $END_CONTROL
    tend   = 50.0
    nend   = 10           ! We are only testing the equilibrium 
 /

 $OUTPUT_CONTROL
    problem_name = 'stratbox'
    run_id = 'tst'
    dt_hdf  = 1e-20
    dt_res  = 0.0
    dt_log  = 1e-20
    dt_tsl  = 1e-20
    vars(1:) = 'ener', 'dens', 'magx', 'magy', 'magz', 'velx', 'vely', 'velz'
 /

 $NUMERICAL_SETUP
    cfl    = 0.3
    smalld = 1.e-6
    smallei= 1.e-7
    limiter= 'vanleer'
 /

 $FLUID_IONIZED
    gamma  = 1.66666666666666666
 /


 $PROBLEM_CONTROL
 /

 $GRAVITY
    user_grav    = .true.
    gprofs_target= 'extgp'
    r_gc         = 5000     ! Galactic radius of coordinate system
    nsub         = 10
 /

 $INTERACTIONS
 /

 $AMR
 /
